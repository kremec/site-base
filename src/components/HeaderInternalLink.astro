---
import type { HTMLAttributes } from "astro/types";

type Props = {
  href: HTMLAttributes<"a">["href"];
  label: string;
};

const { href, label } = Astro.props;
---

<a {href} class="group transition duration-300">
  {label}
  <span
    class="mx-auto block h-[1.5px] max-w-0 bg-black transition-all duration-300 group-hover:max-w-full"
  ></span>
</a>

---
import type { CollectionEntry } from "astro:content";
import { SITE_TITLE } from "@/const/names";
import Page from "@/layouts/Page.astro";
import FormattedDate from "@/components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, series, partInSeries, publishedAt } = Astro.props;
---

<Page
  title={`${title} | ${SITE_TITLE} | Blog`}
  description={description}
  heading={title}
  subheading={`${series} - Part ${partInSeries}\n${publishedAt.toLocaleDateString(
    "en-si",
    {
      year: "numeric",
      month: "short",
      day: "numeric",
    },
  )}`}
>
  <article class="prose">
    <slot />
  </article>
</Page>
